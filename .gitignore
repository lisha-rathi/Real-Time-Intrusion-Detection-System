
# ==========================================
# Python virtual environments
# ==========================================
venv/
.venv/
env/

# ==========================================
# Python cache and compiled files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Local databases and runtime data
# ==========================================
model/predictions.db
*.sqlite
*.sqlite3

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
tmp/
temp/

# ==========================================
# IDE and operating system files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Test and build artifacts
# ==========================================
.pytest_cache/
.coverage
htmlcov/
coverage/
dist/
build/

# ==========================================
# Dataset files
# Keep datasets out of Git by default
# ==========================================
data/*.csv

# ==========================================
# Model artifacts
# Keep required trained models in Git
# ==========================================
# Do not ignore the entire model/ directory.
# Required files are intentionally tracked:
# rf_model.pkl
# dl_model.keras
# feature_names.pkl
# label_encoder.pkl
# scaler.pkl
# metrics.json

# Legacy model format
model/dl_model.h5
